{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.1,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1,
    "base_url": "https://api.deepseek.com",
    "languages": [
      "zh",
      "en"
    ]
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "ai-agent-impact",
    "profile_settings": {
      "ai-agent-impact": {
        "threshold": 8.0,
        "topic_dedup": true
      },
      "tech-news": {
        "threshold": 8.5,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 7.5,
        "topic_dedup": true
      },
      "finance-news": {
        "threshold": 9.0,
        "topic_dedup": true
      }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
  "email": {
    "enabled": false,
    "smtp_server": "smtp.163.com",
    "smtp_port": 465,
    "smtp_username": "15211044232@163.com",
    "imap_enabled": false,
    "imap_server": "imap.163.com",
    "imap_port": 993,
    "email_address": "15211044232@163.com",
    "password_env": "EMAIL_PASSWORD",
    "sender_name": "Horizon Daily",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },
