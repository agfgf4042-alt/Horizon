      "enabled": true,
      "channels": [
        {
          "channel": "zaihuapd",
          "enabled": true,
          "fetch_limit": 20,
          "profile": "ai-agent-impact"
        }
      ]
    },
    "gdelt": {
      "enabled": true,
      "query": "(\"AI agent\" OR \"autonomous agent\") AND (people OR individual OR labor OR education OR health OR privacy OR safety OR governance OR society)",
      "mode": "ArtList",
      "max_records": 50,
      "timespan": "1d",
      "language": "English",
      "country": null,
      "category": "ai-agent-impact",
      "profile": "ai-agent-impact"
    },
    "google_news": {
      "enabled": true,
      "query": "AI agents people individuals labor education health privacy safety mental health relationships governance",
      "language": "en",
      "country": "US",
      "ceid": null,
      "max_results": 50,
      "category": "ai-agent-impact",
      "profile": "ai-agent-impact"
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": null,
    "profile_order": [
      "ai-agent-impact",
      "tech-news",
      "tech-blog",
      "finance-news"
    ],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "msgtype": "markdown",
      "markdown": {
        "content": "#{message_title}\n\n#{summary?limit=2500&split=---}"
      }
    },
    "headers": ""
  }
}
